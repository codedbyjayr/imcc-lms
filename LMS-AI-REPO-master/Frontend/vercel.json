{
  "version": 2,
  "builds": [
    {
      "src": "LMS-AI-REPO-master/Frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "LMS-AI-REPO-master/Backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "LMS-AI-REPO-master/Backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "LMS-AI-REPO-master/Frontend/$1"
    }
  ]
}
