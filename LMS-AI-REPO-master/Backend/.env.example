# ─────────────────────────────────────────────────────────────────────────────
# LMS AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# A long random secret used to sign JWT chatbot tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_IDENTITY_SECRET=your_random_secret_here

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# n8n Webhook URL for the AI chat flow
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/your-webhook-id

# Flowise (self-hosted LLM UI) connection
FLOWISE_URL=http://localhost:3000
FLOWISE_CHATFLOW_ID=your-flowise-chatflow-uuid

# PostgreSQL Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=AI-LMS
DB_PASSWORD=your_db_password_here
DB_PORT=5432
